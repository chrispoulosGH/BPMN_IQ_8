# Copy to .env (git-ignored). Never commit the token.
# local   = keep telemetry in ./data only
# observe = also export to Observe Inc
OBSERVE_MODE=observe
# Your account's collection URL (Observe: Data & integrations > Add data), no trailing slash
OBSERVE_COLLECTION_ENDPOINT=https://YOUR_CUSTOMER_ID.collect.observeinc.com
# Ingest token, "<token-id>:<secret>"
OBSERVE_INGEST_TOKEN=

# Traffic
DAILY_JOURNEYS=300
SIM_TIMEZONE=America/New_York
# 1 = compressed human waits (an instance takes a few minutes); 0.2 = faster
WAIT_SCALE=1
ABANDON_RATE=0.03
INCIDENTS_PER_DAY_PER_APP=0.5
# Force an incident on one app at startup, e.g. CREDIT-DECIDE
FORCE_INCIDENT_APP=
