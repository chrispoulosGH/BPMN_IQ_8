{
  "name": "bpmn-iq-mockprod",
  "version": "0.1.0",
  "private": true,
  "description": "Mock production environment: simulated applications running three BPMN business flows end to end, instrumented with OpenTelemetry.",
  "main": "src/launcher.js",
  "scripts": {
    "start": "node src/launcher.js",
    "burst": "node src/tools/burst.js",
    "reconstruct": "node src/tools/reconstruct-bpmn.js",
    "check": "node --check src/launcher.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opentelemetry/api": ">=1.10.0 <1.11.0",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-undici": "^0.35.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "express": "^4.22.3"
  }
}
