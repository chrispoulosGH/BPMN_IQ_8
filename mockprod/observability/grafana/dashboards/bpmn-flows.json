{
  "uid": "bpmn-iq-flows",
  "title": "BPMN business flows",
  "description": "Mock production: the three car-purchase flows, their applications and traces (Tempo + Prometheus).",
  "tags": [
    "bpmn-iq",
    "mockprod",
    "opentelemetry"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "flow",
        "label": "Business flow",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(bpmn_process_instances_total, bpmn_process_name)",
          "refId": "flow"
        },
        "definition": "label_values(bpmn_process_instances_total, bpmn_process_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "title": "Explore traces",
      "type": "link",
      "url": "/explore?left=%7B%22datasource%22:%22tempo%22%7D",
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Vehicles sold",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Vehicles sold",
      "description": "Units delivered in the selected time range: new (online, in-store, fleet) and used (wholesale). Fleet orders count every vehicle.",
